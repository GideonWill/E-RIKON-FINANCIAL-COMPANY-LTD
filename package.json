{
  "name": "e-rikon-group-ecfms",
  "version": "1.0.0",
  "description": "E-RIKON Core Financial Management System (ECFMS) Monorepo Root",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run start:dev --prefix backend",
    "build": "npm run build --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "lint": "npm run lint --prefix frontend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "prisma:generate": "npm run prisma:generate --prefix backend",
    "prisma:seed": "npm run prisma:seed --prefix backend",
    "prisma:clear": "npm run prisma:clear --prefix backend"
  }
}
